<div class="educations">
    <div class="section-title">{{.Labels.Education}}</div>
    {{ range .Education }}
        <div class="element">
            <div class="degree">
                {{ .StudyType }} {{ .Area }}
            </div>
            <div class="infos">
                <span class="schooladdress">
                    <span>{{ .Institution }}</span>
                    {{if .Location}}
                        <span> / {{.Location}}</span>
                    {{end}}
                    <span class="dates"> / {{ formatDate "January 2006" .StartDate $.Meta.Lang }} - {{ formatDate "January 2006" .EndDate $.Meta.Lang }}</span>
                </span>
            </div>
        </div>
    {{end}}
</div>

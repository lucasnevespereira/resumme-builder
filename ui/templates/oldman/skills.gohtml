{{if .Skills}}
    <div class="skills">
        <div class="subtitle">{{.Labels.Skills}}</div>
        <div class="item">
            {{ range $index, $skill := .Skills}}
                <span class="value">
             {{evaluate $skill.Name}}{{if $skill.Keywords}} ({{range $i, $kw := $skill.Keywords}}{{if $i}}, {{end}}{{$kw}}{{end}}){{end}}{{if not (isLast $index (len $.Skills))}},{{end}}
        </span>
            {{end}}
        </div>
    </div>
{{end}}
